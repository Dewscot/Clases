    "plt.plot(t, y_exacta, label=\"Analítica\")\n",
    "plt.plot(t, y_RK2, 'o', label=\"RK2\")\n",
    "plt.plot(t, y_RK4, '--', label=\"RK4\")\n",
    "\n",
