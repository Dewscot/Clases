    "\n",
    "def f(x, omega, g = 9.8):\n",
    "    y, u = x \n",
    "    return np.array([u,-g-y*omega**2])\n",
    "\n",
    "x = np.zeros([Ntiempo, 2])\n",
    "x[0,0] = 0\n",
    "x[0,1] = 0\n",
    "h=0.222\n",
    "\n",
    "for n in range(Ntiempo-1):\n",
    "    x[n+1] = x[n] + h*f(x[n], omega, g)\n",
    "y = x[:,0]\n",
    "u = x[:,1]\n",
    "\n",
    "plt.scatter(t,y)\n",
    "\n",
    "#Version analitica \n",
    "y_exacta = (g/omega**2)*(np.cos(omega*t)-1)\n",
    "\n",
    "plt.plot(t, y_exacta, label=\"Analítica\")\n",
    "plt.plot(t, y, 'o', label=\"Euler\")\n",
    "\n",
    "plt.xlabel(\"Tiempo\")\n",
    "plt.ylabel(\"Posición\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
