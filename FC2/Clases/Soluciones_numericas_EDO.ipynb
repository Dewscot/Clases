    "y_SR = np.zeros(Ntiempo)\n",
    "v_SR = np.zeros(Ntiempo)\n",
    "\n",
    "y_SR[0] = 0\n",
    "v0 = 0\n",
    "\n",
    "# Inicialización: velocidad en t = h/2\n",
    "v_SR[0] = v0 + (h/2)*(-y_SR[0]*omega**2 - g)\n",
    "\n",
    "for n in range(Ntiempo-1):\n",
    "    y_SR[n+1] = y_SR[n] + h*v_SR[n]\n",
    "    v_SR[n+1] = v_SR[n] + h*(-y_SR[n+1]*omega**2 - g)\n",
    "\n",
    "\n",
    "plt.plot(t, y_exacta, label=\"Analítica\")\n",
    "plt.plot(t, y_SR, 'o', label=\"Salto de Rana\")\n",
    "\n",
    "plt.xlabel(\"Tiempo\")\n",
    "plt.ylabel(\"Posición\")\n",
    "plt.legend()\n",
    "plt.show()"
