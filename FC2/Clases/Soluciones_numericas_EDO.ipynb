    "u_SR = np.zeros(Ntiempo)\n",
    "u_SR[0] = v0\n",
    "\n",
    "# Velocidades en tiempos enteros\n",
    "u_SR[1:] = (v_SR[:-1] + v_SR[1:])/2\n",
    "\n",
    "E_SR = u_SR**2/2 + (omega**2/2)*(y_SR+g/omega**2)**2\n",
    "\n",
    "plt.plot(t, E, label=\"Euler\")\n",
    "plt.plot(t, E_EC, label=\"Euler-Cromer\")\n",
    "plt.plot(t, E_SR, label=\"Salto de Rana\")\n",
    "\n",
